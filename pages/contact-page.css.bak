/* Contact page — Technomantra India */
:root {
  --contact-navy: #06295e;
  --contact-blue: #0868bd;
  --contact-orange: #f7941d;
  --contact-ink: #102f59;
  --contact-muted: #617590;
  --contact-line: #dbe8f4;
}

.contact-page,
.contact-page * {
  box-sizing: border-box;
}

.contact-page {
  margin: 0;
  color: var(--contact-ink);
  background: #f6fbff;
  font-family: "Inter", Arial, sans-serif;
}

.contact-page a {
  color: inherit;
  text-decoration: none;
}

.contact-header {
  position: sticky;
  top: 0;
  z-index: 20;
  border-top: 3px solid var(--contact-blue);
  border-bottom: 1px solid rgba(8, 104, 189, 0.12);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 6px 22px rgba(6, 41, 94, 0.07);
  backdrop-filter: blur(12px);
}

.contact-header-inner {
  width: min(1180px, calc(100% - 40px));
  min-height: 78px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.contact-brand img {
  display: block;
  width: 154px;
  height: auto;
}

.contact-nav {
  display: flex;
  align-items: center;
  gap: 28px;
  color: #294769;
  font-size: 14px;
  font-weight: 600;
}

.contact-nav a {
  position: relative;
  padding: 29px 0 27px;
  transition: color 0.2s ease;
}

.contact-nav a::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 20px;
  left: 0;
  height: 2px;
  border-radius: 2px;
  background: var(--contact-orange);
  transform: scaleX(0);
  transition: transform 0.2s ease;
}

.contact-nav a:hover,
.contact-nav a[aria-current="page"] {
  color: var(--contact-blue);
}

.contact-nav a:hover::after,
.contact-nav a[aria-current="page"]::after {
  transform: scaleX(1);
}

.contact-header-cta,
.contact-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 0;
  border-radius: 8px;
  color: #fff !important;
  background: linear-gradient(135deg, #087bd7, #075bad);
  box-shadow: 0 10px 22px rgba(8, 104, 189, 0.22);
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.contact-header-cta {
  padding: 13px 18px;
  font-size: 13px;
}

.contact-header-cta:hover,
.contact-submit:hover {
  transform: translateY(-2px);
  box-shadow: 0 13px 26px rgba(8, 104, 189, 0.28);
}

.contact-hero {
  position: relative;
  min-height: 420px;
  overflow: hidden;
  display: flex;
  align-items: center;
  background: linear-gradient(110deg, #06295e 0%, #075ca9 58%, #0b82d5 100%);
}

.contact-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(3, 26, 63, 0.92) 0%, rgba(3, 51, 105, 0.68) 49%, rgba(4, 75, 130, 0.35) 100%);
  z-index: 1;
}

.contact-hero::after {
  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  right: -150px;
  bottom: -260px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  box-shadow: 0 0 0 40px rgba(255, 255, 255, 0.04), 0 0 0 80px rgba(255, 255, 255, 0.03);
  z-index: 2;
}

.contact-hero-image {
  position: absolute;
  inset: 0 0 0 43%;
  width: 57%;
  height: 100%;
  object-fit: cover;
  opacity: 0.56;
  mix-blend-mode: screen;
}

.contact-hero-inner {
  position: relative;
  z-index: 3;
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
  padding: 72px 0 82px;
}

.contact-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  color: #ffd18d;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2.8px;
  text-transform: uppercase;
}

.contact-eyebrow::before {
  content: "";
  width: 30px;
  height: 2px;
  border-radius: 2px;
  background: var(--contact-orange);
}

.contact-hero h1 {
  max-width: 660px;
  margin: 0 0 18px;
  color: #fff;
  font-family: "Lora", Georgia, serif;
  font-size: clamp(42px, 5vw, 70px);
  line-height: 1.05;
  letter-spacing: -1.5px;
}

.contact-hero h1 span {
  color: #ff9b22;
}

.contact-hero p {
  max-width: 590px;
  margin: 0;
  color: rgba(255, 255, 255, 0.84);
  font-size: 17px;
  line-height: 1.7;
}

.contact-main {
  position: relative;
  z-index: 4;
  width: min(1180px, calc(100% - 40px));
  margin: -54px auto 90px;
}

.contact-layout {
  display: grid;
  grid-template-columns: 0.82fr 1.18fr;
  gap: 24px;
  align-items: stretch;
}

.contact-info-card,
.contact-form-card {
  border: 1px solid var(--contact-line);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 18px 48px rgba(5, 48, 94, 0.1);
}

.contact-info-card {
  position: relative;
  overflow: hidden;
  padding: 36px 32px;
  background: linear-gradient(145deg, #fff 0%, #f2f9ff 100%);
}

.contact-info-card::after {
  content: "";
  position: absolute;
  right: -70px;
  bottom: -90px;
  width: 220px;
  height: 220px;
  border: 1px solid rgba(247, 148, 29, 0.38);
  border-radius: 50%;
  box-shadow: 0 0 0 24px rgba(247, 148, 29, 0.05), 0 0 0 48px rgba(247, 148, 29, 0.04);
}

.contact-info-card h2,
.contact-form-card h2 {
  position: relative;
  z-index: 1;
  margin: 0 0 10px;
  color: var(--contact-navy);
  font-size: 26px;
  line-height: 1.2;
}

.contact-info-card > p,
.contact-form-card > p {
  position: relative;
  z-index: 1;
  margin: 0 0 28px;
  color: var(--contact-muted);
  font-size: 14px;
  line-height: 1.65;
}

.contact-details {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 20px;
  margin: 0;
}

.contact-detail {
  display: grid;
  grid-template-columns: 42px 1fr;
  gap: 13px;
  align-items: start;
}

.contact-detail-icon {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border: 1px solid rgba(8, 104, 189, 0.2);
  border-radius: 12px;
  color: var(--contact-blue);
  background: #eaf4ff;
  font-size: 18px;
}

.contact-detail strong {
  display: block;
  margin: 2px 0 4px;
  color: var(--contact-navy);
  font-size: 14px;
}

.contact-detail span:last-child,
.contact-detail a {
  color: var(--contact-muted);
  font-size: 13px;
  line-height: 1.55;
}

.contact-detail a:hover {
  color: var(--contact-blue);
}

.contact-form-card {
  padding: 36px 38px;
}

.contact-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 17px;
}

.contact-field {
  display: grid;
  gap: 7px;
}

.contact-field.full {
  grid-column: 1 / -1;
}

.contact-field label {
  color: var(--contact-navy);
  font-size: 12px;
  font-weight: 700;
}

.contact-field input,
.contact-field select,
.contact-field textarea {
  width: 100%;
  border: 1px solid #cfdeed;
  border-radius: 8px;
  outline: none;
  padding: 12px 13px;
  color: var(--contact-ink);
  background: #fbfdff;
  font: inherit;
  font-size: 13px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.contact-field textarea {
  min-height: 108px;
  resize: vertical;
}

.contact-field input:focus,
.contact-field select:focus,
.contact-field textarea:focus {
  border-color: var(--contact-blue);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(8, 104, 189, 0.11);
}

.contact-submit {
  justify-self: start;
  padding: 13px 22px;
  font-size: 13px;
}

.contact-form-note {
  align-self: center;
  margin: 0;
  color: var(--contact-muted);
  font-size: 12px;
  line-height: 1.45;
}

.contact-form-actions {
  grid-column: 1 / -1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  padding-top: 3px;
}

.contact-success {
  display: none;
  grid-column: 1 / -1;
  margin: 0;
  padding: 11px 13px;
  border: 1px solid #a8dcbf;
  border-radius: 8px;
  color: #1c7049;
  background: #effbf4;
  font-size: 13px;
}

.contact-success.is-visible {
  display: block;
}

.contact-reassurance {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-top: 24px;
  padding: 25px 30px;
  border: 1px solid #d9e8f5;
  border-radius: 16px;
  background: #fff;
}

.contact-reassurance-item {
  display: flex;
  align-items: center;
  gap: 11px;
  color: var(--contact-muted);
  font-size: 12px;
  line-height: 1.4;
}

.contact-reassurance-item b {
  display: block;
  margin-bottom: 2px;
  color: var(--contact-navy);
  font-size: 13px;
}

.contact-reassurance-item > span:first-child {
  display: grid;
  flex: 0 0 34px;
  width: 34px;
  height: 34px;
  place-items: center;
  border-radius: 50%;
  color: #fff;
  background: var(--contact-orange);
  font-size: 15px;
}

.contact-footer {
  border-top: 4px solid transparent;
  border-image: linear-gradient(90deg, var(--contact-blue), var(--contact-orange)) 1;
  color: rgba(255, 255, 255, 0.74);
  background: linear-gradient(120deg, #041f4d, #07549b);
}

.contact-footer-inner {
  width: min(1180px, calc(100% - 40px));
  min-height: 118px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.contact-footer-brand {
  display: flex;
  align-items: center;
  gap: 13px;
  color: #fff;
  font-size: 16px;
  font-weight: 700;
}

.contact-footer-brand img {
  width: 138px;
  padding: 7px;
  border-radius: 5px;
  background: #fff;
}

.contact-footer-copy {
  margin: 6px 0 0;
  color: rgba(255, 255, 255, 0.67);
  font-size: 12px;
}

.contact-footer-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 20px;
  font-size: 12px;
}

.contact-footer-links a:hover {
  color: #fff;
}

@media (max-width: 860px) {
  .contact-nav {
    gap: 15px;
    font-size: 12px;
  }

  .contact-nav a {
    padding: 29px 0 27px;
  }

  .contact-header-cta {
    display: none;
  }

  .contact-layout {
    grid-template-columns: 1fr;
  }

  .contact-reassurance {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 620px) {
  .contact-header-inner,
  .contact-hero-inner,
  .contact-main,
  .contact-footer-inner {
    width: min(100% - 28px, 520px);
  }

  .contact-header-inner {
    min-height: 68px;
  }

  .contact-brand img {
    width: 125px;
  }

  .contact-nav {
    gap: 12px;
  }

  .contact-nav a {
    padding: 24px 0 22px;
    font-size: 11px;
  }

  .contact-nav a:nth-child(-n + 2) {
    display: none;
  }

  .contact-hero {
    min-height: 390px;
  }

  .contact-hero-image {
    inset: 0;
    width: 100%;
    opacity: 0.28;
  }

  .contact-hero-inner {
    padding: 62px 0 75px;
  }

  .contact-hero h1 {
    font-size: 42px;
  }

  .contact-hero p {
    font-size: 14px;
  }

  .contact-main {
    margin-top: -35px;
    margin-bottom: 55px;
  }

  .contact-info-card,
  .contact-form-card {
    padding: 27px 21px;
    border-radius: 15px;
  }

  .contact-form {
    grid-template-columns: 1fr;
  }

  .contact-field.full,
  .contact-form-actions,
  .contact-success {
    grid-column: auto;
  }

  .contact-footer-inner {
    min-height: 170px;
    padding: 25px 0;
    align-items: flex-start;
    flex-direction: column;
  }

  .contact-footer-links {
    justify-content: flex-start;
  }
}

/* Final visual polish: wider composition, stronger typography and cleaner contrast. */
@media (min-width: 901px) {
  .contact-page .header-container,
  .contact-page .contact-hero-inner,
  .contact-page .contact-main,
  .contact-page .footer-container,
  .contact-page .bottom-container { max-width: 1600px; }

  .contact-page .header-container { height: 76px; padding-left: 26px; padding-right: 26px; }
  .contact-page .site-header .brand-symbol { width: 174px; height: 58px; flex-basis: 174px; }
  .contact-page .nav-list { gap: clamp(18px, 1.6vw, 30px); }
  .contact-page .nav-link { font-size: 13px; }

  .contact-page .contact-hero { min-height: 360px; }
  .contact-page .contact-hero-inner { padding-top: 36px; padding-bottom: 60px; }
  .contact-page .contact-hero h1 { font-size: clamp(50px, 4.5vw, 72px); }
  .contact-page .contact-hero h2 { font-size: 25px; }
  .contact-page .contact-hero p { max-width: 560px; font-size: 15px; }
  .contact-page .contact-breadcrumb { font-size: 13px; }

  .contact-page .contact-main { margin-top: -2px; }
  .contact-quick-grid { gap: 16px; }
  .contact-quick-card { min-height: 103px; padding: 19px 22px; gap: 15px; }
  .quick-icon { flex-basis: 46px; width: 46px; height: 46px; font-size: 10px; }
  .contact-quick-card b { font-size: 13px; }
  .contact-quick-card strong { font-size: 14px; }
  .contact-quick-card small { font-size: 12px; }

  .contact-work-grid { gap: 22px; margin-top: 26px; }
  .contact-page .contact-form-card { padding: 34px 34px 32px; }
  .contact-page .contact-form-card h2 { font-size: 39px; }
  .contact-page .contact-form-card > p { font-size: 14px; margin-bottom: 24px; }
  .contact-page .contact-form { gap: 17px; }
  .contact-page .contact-field label { font-size: 12px; }
  .contact-page .contact-field input,
  .contact-page .contact-field select,
  .contact-page .contact-field textarea { padding: 13px 14px; font-size: 13px; }
  .contact-page .contact-field textarea { min-height: 125px; }
  .contact-page .contact-submit { padding: 14px 34px; font-size: 13px; }

  .contact-why-card,
  .contact-why-card > img { min-height: 260px; height: 260px; }
  .contact-why-panel { top: 32px; right: 28px; width: 260px; padding: 22px 25px; }
  .contact-why-panel h3 { font-size: 22px; }
  .contact-why-panel ul { gap: 11px; font-size: 13px; }
  .contact-why-panel li::before { width: 17px; height: 17px; font-size: 10px; }
  .contact-page .contact-office-card { padding: 25px 27px; }
  .contact-page .contact-office-card h2 { font-size: 22px; }
  .office-details-grid { gap: 20px 32px; }
  .office-details-grid b { font-size: 13px; }
  .office-details-grid span, .office-details-grid a { font-size: 12px; }

  .contact-map-section { gap: 42px; margin-top: 52px; padding-top: 38px; }
  .contact-map-copy h2 { font-size: 40px; }
  .contact-map-copy > p { font-size: 14px; }
  .map-contact-list > * { padding: 12px 15px; }
  .map-contact-list b, .map-contact-list span { font-size: 12px; }
  .contact-map-visual { min-height: 330px; }
  .label-city { font-size: 28px; }
  .label-area { font-size: 14px; }
  .map-pin { font-size: 12px; }

  .contact-cta-strip { min-height: 156px; margin: 56px calc((1600px - 100vw) / 2) -2px; padding: 35px max(26px, calc((100vw - 1600px) / 2)); }
  .contact-cta-strip h2 { font-size: 32px; }
  .contact-cta-strip p { font-size: 14px; }
  .contact-cta-strip a { padding: 15px 28px; font-size: 13px; }

  .contact-page .footer-body { padding: 58px 0 48px; }
  .contact-page .footer-container { gap: clamp(34px, 5vw, 84px); }
  .contact-page .about-text { max-width: 360px; font-size: 14px; }
  .contact-page .col-title { font-size: 18px; }
  .contact-page .footer-nav-list a { font-size: 13px; }
  .contact-page .contact-text { font-size: 13px; }
  .contact-page .footer-bottom { padding: 22px 0; }
  .contact-page .copyright-text { font-size: 13px; }
}

/* Reference-style contact page finish */
.contact-page {
  background: #f4faff !important;
  color: #0b315f;
}

.contact-page .site-header {
  background: #fff !important;
  border-bottom: 1px solid #e2ebf4 !important;
}

.contact-page .header-container {
  max-width: 1180px;
  height: 70px;
  padding: 0 18px;
}

.contact-page .site-header .brand-symbol {
  width: 142px;
  height: 50px;
  flex-basis: 142px;
}

.contact-page .nav-list {
  gap: 20px;
}

.contact-page .nav-link {
  padding: 24px 0 22px;
  color: #123b6d;
  font-size: 12px;
}

.contact-page .nav-link.active {
  color: #0b65b8;
}

.contact-page .header-btn-touch {
  padding: 10px 18px;
  font-size: 12px;
  background: linear-gradient(135deg, #ff9b19, #f37021);
}

.contact-page .contact-hero {
  min-height: 300px;
  align-items: flex-start;
  background: #eaf6ff;
}

.contact-page .contact-hero::before {
  background: linear-gradient(90deg, rgba(255, 255, 255, .97) 0%, rgba(255, 255, 255, .86) 31%, rgba(255, 255, 255, .12) 73%, rgba(255, 255, 255, .08) 100%);
}

.contact-page .contact-hero::after {
  right: auto;
  left: -160px;
  bottom: -310px;
  width: 550px;
  height: 550px;
  border-color: rgba(33, 150, 243, .24);
  box-shadow: 0 0 0 70px rgba(33, 150, 243, .08), 0 0 0 140px rgba(247, 148, 29, .06);
}

.contact-page .contact-hero-image {
  inset: 0 0 0 32%;
  width: 68%;
  opacity: .9;
  mix-blend-mode: normal;
  object-position: center 42%;
}

.contact-page .contact-hero-inner {
  width: min(1180px, calc(100% - 40px));
  padding: 30px 0 52px;
}

.contact-breadcrumb {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 20px;
  color: #164578;
  font-size: 12px;
}

.contact-breadcrumb a:hover { color: #f37021; }

.contact-page .contact-eyebrow {
  display: none;
}

.contact-page .contact-hero h1 {
  max-width: 500px;
  margin: 0 0 4px;
  color: #0b315f;
  font-size: clamp(40px, 4.3vw, 59px);
  line-height: .98;
}

.contact-page .contact-hero h1 span { color: #f37021; }

.contact-page .contact-hero h2 {
  margin: 0 0 10px;
  color: #0b315f;
  font-family: "Lora", Georgia, serif;
  font-size: 20px;
}

.contact-page .contact-hero p {
  max-width: 440px;
  color: #55718f;
  font-size: 13px;
  line-height: 1.55;
}

.contact-page .contact-main {
  width: min(1180px, calc(100% - 40px));
  margin: -2px auto 0;
}

.contact-quick-grid {
  position: relative;
  z-index: 5;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-top: -2px;
}

.contact-quick-card {
  min-height: 82px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border: 1px solid #e0eaf3;
  border-radius: 10px;
  background: rgba(255, 255, 255, .97);
  box-shadow: 0 9px 22px rgba(7, 58, 109, .1);
  transition: transform .2s ease, box-shadow .2s ease;
}

.contact-quick-card:hover { transform: translateY(-3px); box-shadow: 0 13px 26px rgba(7, 58, 109, .15); }

.quick-icon {
  display: grid;
  flex: 0 0 38px;
  width: 38px;
  height: 38px;
  place-items: center;
  border-radius: 50%;
  color: #fff;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .2px;
}

.quick-orange .quick-icon { background: linear-gradient(135deg, #ff9b19, #f37021); }
.quick-blue .quick-icon { background: linear-gradient(135deg, #087ee0, #0060bd); }

.contact-quick-card b,
.contact-quick-card strong,
.contact-quick-card small { display: block; }
.contact-quick-card b { margin-bottom: 4px; color: #0b315f; font-size: 11px; }
.contact-quick-card strong { margin-bottom: 3px; color: #204d7e; font-size: 12px; line-height: 1.25; }
.contact-quick-card small { color: #6c86a0; font-size: 10px; line-height: 1.35; }
.contact-quick-card small i { color: #0878d1; font-style: normal; font-weight: 800; }

.contact-work-grid {
  display: grid;
  grid-template-columns: 1.03fr .97fr;
  gap: 16px;
  margin-top: 22px;
}

.contact-page .contact-form-card,
.contact-page .contact-office-card,
.contact-page .contact-why-card {
  border: 1px solid #e0eaf3;
  border-radius: 10px;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 8px 24px rgba(8, 62, 114, .07);
}

.contact-page .contact-form-card {
  box-shadow: 0 14px 30px rgba(8, 62, 114, .09);
}

.contact-page .contact-form-card h2,
.contact-page .contact-office-card h2,
.contact-page .contact-map-copy h2 {
  letter-spacing: -0.5px;
}

.contact-page .contact-form-card { padding: 24px 26px 25px; }
.contact-page .contact-form-card > p { margin-bottom: 16px; font-size: 12px; }

.contact-section-kicker {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
  color: #0d3a70;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .9px;
}

.contact-section-kicker::before {
  content: "";
  width: 23px;
  height: 2px;
  background: #f37021;
}

.contact-page .contact-form-card h2,
.contact-page .contact-office-card h2 {
  margin-bottom: 6px;
  color: #0b315f;
  font-family: "Lora", Georgia, serif;
  font-size: 29px;
}

.contact-page .contact-form { gap: 12px; }
.contact-page .contact-field { gap: 5px; }
.contact-page .contact-field label { color: #4f6986; font-size: 10px; }
.contact-page .contact-field input,
.contact-page .contact-field select,
.contact-page .contact-field textarea { padding: 10px 12px; border-color: #d6e3ef; border-radius: 6px; color: #24496f; background: #f8fbfe; font-size: 11px; }
.contact-page .contact-field textarea { min-height: 93px; }
.contact-page .contact-submit { padding: 12px 28px; border-radius: 22px; background: linear-gradient(135deg, #ff9b19, #f37021); font-size: 11px; }
.contact-page .contact-form-note { display: none; }

.contact-side { display: grid; align-content: start; gap: 14px; }
.contact-why-card { position: relative; min-height: 203px; overflow: hidden; }
.contact-why-card > img { display: block; width: 100%; height: 203px; object-fit: cover; }
.contact-why-card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(5, 53, 105, .05), rgba(5, 53, 105, .28)); }
.contact-why-panel { position: absolute; z-index: 2; top: 25px; right: 20px; width: 195px; padding: 17px 20px; border-radius: 10px; background: rgba(255,255,255,.96); box-shadow: 0 9px 20px rgba(5, 48, 94, .1); }
.contact-why-panel h3 { margin: 0 0 11px; color: #0b315f; font-family: "Lora", Georgia, serif; font-size: 17px; }
.contact-why-panel ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; color: #587493; font-size: 10px; }
.contact-why-panel li::before { content: "✓"; display: inline-grid; width: 14px; height: 14px; margin-right: 7px; place-items: center; border-radius: 50%; color: #fff; background: #ff8613; font-size: 9px; font-weight: 800; }

.contact-page .contact-office-card { padding: 18px 20px; }
.contact-page .contact-office-card h2 { font-size: 17px; }
.office-details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 22px; margin-top: 13px; }
.office-details-grid > div { display: grid; gap: 3px; padding-left: 17px; border-left: 2px solid #edf3f8; }
.office-details-grid b { color: #0b315f; font-size: 11px; }
.office-details-grid span,
.office-details-grid a { color: #607b99; font-size: 10px; line-height: 1.4; }
.office-details-grid a:hover { color: #f37021; }

.contact-map-section { display: grid; grid-template-columns: .86fr 1.14fr; gap: 22px; align-items: center; margin-top: 38px; padding: 28px 0 0; border-top: 1px solid #d9e7f2; }
.contact-map-copy h2 { margin: 0 0 8px; color: #0b315f; font-family: "Lora", Georgia, serif; font-size: 31px; }
.contact-map-copy > p { max-width: 410px; margin: 0 0 15px; color: #627e9c; font-size: 12px; line-height: 1.55; }
.map-contact-list { display: grid; gap: 7px; }
.map-contact-list > * { display: grid; grid-template-columns: 86px 1fr; gap: 10px; padding: 9px 12px; border: 1px solid #dce9f4; border-radius: 7px; background: rgba(255,255,255,.82); }
.map-contact-list b { color: #0b315f; font-size: 10px; }.map-contact-list span { color: #607b99; font-size: 10px; }
.contact-map-visual { position: relative; min-height: 270px; overflow: hidden; border: 1px solid #d2e2ee; border-radius: 10px; background: #e9f0e7; background-image: linear-gradient(28deg, transparent 47%, rgba(255,255,255,.95) 48%, rgba(255,255,255,.95) 51%, transparent 52%), linear-gradient(110deg, transparent 44%, rgba(255,255,255,.8) 45%, rgba(255,255,255,.8) 48%, transparent 49%), linear-gradient(0deg, rgba(155,194,214,.2) 1px, transparent 1px), linear-gradient(90deg, rgba(155,194,214,.2) 1px, transparent 1px); background-size: 260px 180px, 300px 220px, 38px 38px, 38px 38px; box-shadow: inset 0 0 50px rgba(255,255,255,.55); }
.map-road { position: absolute; display: block; height: 7px; border-top: 3px solid rgba(255,255,255,.95); border-bottom: 2px solid rgba(194,160,109,.3); transform: rotate(-15deg); }
.road-one { top: 44%; left: -10%; width: 120%; }.road-two { top: 23%; left: 27%; width: 82%; transform: rotate(38deg); }.road-three { top: 72%; left: 12%; width: 92%; transform: rotate(12deg); }
.map-label { position: absolute; color: #405a6a; font-size: 13px; font-weight: 700; letter-spacing: .4px; }.label-city { left: 14%; top: 55%; font-size: 22px; }.label-area { left: 44%; top: 63%; font-size: 11px; }
.map-pin { position: absolute; top: 31%; right: 13%; padding: 8px 12px 8px 28px; border-radius: 8px; color: #0b315f; background: #fff; box-shadow: 0 5px 14px rgba(8,60,104,.12); font-size: 10px; font-weight: 800; }.map-pin::before { content: ""; position: absolute; top: 10px; left: 9px; width: 12px; height: 12px; border: 4px solid #ef3d2f; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); }.map-pin small { display: block; margin-top: 3px; color: #5d7690; font-size: 9px; font-weight: 500; }

.contact-cta-strip { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 118px; margin: 42px calc((1180px - 100vw) / 2) -2px; padding: 26px max(20px, calc((100vw - 1180px) / 2)); overflow: hidden; color: #fff; background: linear-gradient(90deg, rgba(3, 50, 101, .96), rgba(5, 91, 157, .9)), url("../assets/refinery-towers.png") center / cover; }
.contact-cta-strip h2 { margin: 0 0 5px; color: #fff; font-family: "Lora", Georgia, serif; font-size: 25px; }.contact-cta-strip p { margin: 0; max-width: 510px; color: rgba(255,255,255,.84); font-size: 12px; }.contact-cta-strip a { display: inline-flex; align-items: center; gap: 13px; padding: 12px 23px; border-radius: 22px; color: #fff; background: linear-gradient(135deg, #ff9b19, #f37021); font-size: 11px; font-weight: 800; white-space: nowrap; }

/* Light reference footer, with the same footer columns and links as the home page. */
.contact-page .site-footer { border-top: 0 !important; color: #194b7e; background: #eaf6ff !important; }
.contact-page .footer-body { padding: 43px 0 36px; background: linear-gradient(115deg, #fff8eb 0%, #f5fbff 44%, #d9efff 100%) !important; }
.contact-page .footer-backdrop { display: block !important; opacity: .15; background: url("../assets/refinery-towers.png") right bottom / cover no-repeat !important; }
.contact-page .footer-backdrop::before { background: linear-gradient(90deg, rgba(255,248,235,.96), rgba(245,251,255,.84) 48%, rgba(213,239,255,.62)) !important; }
.contact-page .footer-container { max-width: 1180px; grid-template-columns: 1.35fr .85fr 1.1fr 1.1fr; gap: 38px; }
.contact-page .brand-footer .brand-symbol { width: 190px; height: 58px; flex-basis: 190px; background: #fff; }.contact-page .brand-footer { margin-bottom: 14px; }.contact-page .brand-footer .brand-image { max-width: 190px; }
.contact-page .about-text, .contact-page .footer-nav-list a, .contact-page .contact-text, .contact-page .contact-text a { color: #315d88 !important; }.contact-page .about-text { max-width: 290px; font-size: 12px; line-height: 1.55; }.contact-page .col-title { color: #0b315f !important; font-size: 15px; }.contact-page .col-title::after { background: #f37021 !important; }.contact-page .footer-nav-list { gap: 8px; }.contact-page .footer-nav-list a { font-size: 11px; }.contact-page .footer-nav-list a::before { color: #0878d1 !important; }.contact-page .contact-icon-circle { background: linear-gradient(135deg, #0878d1, #0755a2) !important; }.contact-page .contact-text { font-size: 11px; }
.contact-page .footer-bottom { background: #063e7f !important; border-top: 3px solid #0878d1 !important; }.contact-page .bottom-container { max-width: 1180px; justify-content: center !important; }.contact-page .copyright-text { color: #fff !important; font-size: 11px; text-align: center; }

/* Desktop scale correction — keep the reference composition spacious and readable. */
@media (min-width: 901px) {
  .contact-page .header-container,
  .contact-page .contact-hero-inner,
  .contact-page .contact-main,
  .contact-page .footer-container,
  .contact-page .bottom-container { max-width: 1600px; }
  .contact-page .header-container { height: 76px; padding-left: 26px; padding-right: 26px; }
  .contact-page .site-header .brand-symbol { width: 174px; height: 58px; flex-basis: 174px; }
  .contact-page .nav-list { gap: clamp(18px, 1.6vw, 30px); }
  .contact-page .nav-link { font-size: 13px; }
  .contact-page .contact-hero { min-height: 360px; }
  .contact-page .contact-hero-inner { padding-top: 36px; padding-bottom: 60px; }
  .contact-page .contact-hero h1 { font-size: clamp(50px, 4.5vw, 72px); }
  .contact-page .contact-hero h2 { font-size: 25px; }
  .contact-page .contact-hero p { max-width: 560px; font-size: 15px; }
  .contact-page .contact-breadcrumb { font-size: 13px; }
  .contact-quick-grid { gap: 16px; }
  .contact-quick-card { min-height: 103px; padding: 19px 22px; gap: 15px; }
  .quick-icon { flex-basis: 46px; width: 46px; height: 46px; font-size: 10px; }
  .contact-quick-card b { font-size: 13px; }
  .contact-quick-card strong { font-size: 14px; }
  .contact-quick-card small { font-size: 12px; }
  .contact-work-grid { gap: 22px; margin-top: 26px; }
  .contact-page .contact-form-card { padding: 34px; }
  .contact-page .contact-form-card h2 { font-size: 39px; }
  .contact-page .contact-form-card > p { font-size: 14px; margin-bottom: 24px; }
  .contact-page .contact-form { gap: 17px; }
  .contact-page .contact-field label { font-size: 12px; }
  .contact-page .contact-field input,
  .contact-page .contact-field select,
  .contact-page .contact-field textarea { padding: 13px 14px; font-size: 13px; }
  .contact-page .contact-field textarea { min-height: 125px; }
  .contact-page .contact-submit { padding: 14px 34px; font-size: 13px; }
  .contact-why-card, .contact-why-card > img { min-height: 260px; height: 260px; }
  .contact-why-panel { top: 32px; right: 28px; width: 260px; padding: 22px 25px; }
  .contact-why-panel h3 { font-size: 22px; }
  .contact-why-panel ul { gap: 11px; font-size: 13px; }
  .contact-page .contact-office-card { padding: 25px 27px; }
  .contact-page .contact-office-card h2 { font-size: 22px; }
  .office-details-grid { gap: 20px 32px; }
  .office-details-grid b { font-size: 13px; }
  .office-details-grid span, .office-details-grid a { font-size: 12px; }
  .contact-map-section { gap: 42px; margin-top: 52px; padding-top: 38px; }
  .contact-map-copy h2 { font-size: 40px; }
  .contact-map-copy > p { font-size: 14px; }
  .map-contact-list > * { padding: 12px 15px; }
  .map-contact-list b, .map-contact-list span { font-size: 12px; }
  .contact-map-visual { min-height: 330px; }
  .label-city { font-size: 28px; }
  .label-area { font-size: 14px; }
  .map-pin { font-size: 12px; }
  .contact-cta-strip { min-height: 156px; margin: 56px calc((1600px - 100vw) / 2) -2px; padding: 35px max(26px, calc((100vw - 1600px) / 2)); }
  .contact-cta-strip h2 { font-size: 32px; }
  .contact-cta-strip p { font-size: 14px; }
  .contact-cta-strip a { padding: 15px 28px; font-size: 13px; }
  .contact-page .footer-body { padding: 58px 0 48px; }
  .contact-page .footer-container { gap: clamp(34px, 5vw, 84px); }
  .contact-page .about-text { max-width: 360px; font-size: 14px; }
  .contact-page .col-title { font-size: 18px; }
  .contact-page .footer-nav-list a { font-size: 13px; }
  .contact-page .contact-text { font-size: 13px; }
  .contact-page .footer-bottom { padding: 22px 0; }
  .contact-page .copyright-text { font-size: 13px; }
}

/* Use the supplied finished contact banner without duplicating its embedded title. */
.contact-page .contact-hero {
  min-height: clamp(300px, 28vw, 500px) !important;
  background: #eaf6ff !important;
}

.contact-page .contact-hero::before,
.contact-page .contact-hero::after { display: none !important; }

.contact-page .contact-hero-image {
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  object-position: center !important;
  opacity: 1 !important;
  mix-blend-mode: normal !important;
}

.contact-page .contact-hero-inner {
  position: relative;
  z-index: 3;
  padding-top: 22px !important;
  padding-bottom: 22px !important;
}

.contact-page .contact-hero-inner .contact-eyebrow,
.contact-page .contact-hero-inner h1,
.contact-page .contact-hero-inner h2,
.contact-page .contact-hero-inner p { display: none !important; }

.contact-page .contact-breadcrumb {
  margin: 0;
  color: #0b315f;
  font-size: 12px;
  text-shadow: 0 1px 2px rgba(255, 255, 255, .7);
}

/* Match the home page CTA component exactly. */
.contact-page .cta-section {
  margin: 0 !important;
  padding: 50px 24px 58px !important;
  background: transparent !important;
  overflow: hidden !important;
}

.contact-page .contact-main {
  padding-bottom: 0;
}

.contact-page .cta-panel {
  width: min(100%, 1500px) !important;
  max-width: 1500px !important;
  min-height: 220px !important;
  padding: 18px !important;
  border-radius: 26px !important;
}

.contact-page .cta-panel-inner {
  min-height: 174px !important;
  padding: 24px 42px !important;
  border-radius: 20px !important;
}

/* Slightly narrower contact-page canvas for cleaner side breathing room. */
@media (min-width: 901px) {
  .contact-page .contact-hero-inner,
  .contact-page .contact-main {
    width: min(1350px, calc(100% - 80px)) !important;
    max-width: 1350px !important;
  }
}

/* Real map presentation: clean card framing with a live Google Maps embed. */
.contact-page .contact-map-section {
  position: relative;
  overflow: hidden;
  margin-top: 48px;
  padding: 34px;
  border: 1px solid #dce9f4;
  border-top: 1px solid #dce9f4;
  border-radius: 18px;
  background: linear-gradient(135deg, #ffffff 0%, #f2f9ff 100%);
  box-shadow: 0 14px 32px rgba(6, 55, 105, 0.08);
}

.contact-page .contact-map-copy h2 {
  font-size: clamp(30px, 3vw, 42px);
}

.contact-page .contact-map-visual {
  height: 330px;
  min-height: 0;
  overflow: hidden;
  border: 1px solid #cbddea;
  border-radius: 14px;
  background: #e9f0e7;
  box-shadow: 0 8px 22px rgba(8, 62, 114, 0.12);
}

.contact-page .contact-map-visual iframe {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 330px;
  border: 0;
}

.contact-page .contact-map-visual .map-road,
.contact-page .contact-map-visual .map-label,
.contact-page .contact-map-visual .map-pin { display: none; }

@media (max-width: 620px) {
  .contact-page .contact-map-section { padding: 22px 16px; border-radius: 14px; }
  .contact-page .contact-map-visual { height: 240px; }
  .contact-page .contact-map-visual iframe { min-height: 240px; }
}

/* Quick contact cards: compact, aligned and visually separated from the banner. */
.contact-quick-grid {
  gap: 14px;
  margin-top: -12px;
}

.contact-quick-card {
  position: relative;
  min-height: 92px;
  overflow: hidden;
  padding: 16px 18px;
  border: 1px solid #d9e6f2;
  border-top: 3px solid #0b78d0;
  border-radius: 13px;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12px 26px rgba(6, 55, 105, 0.11);
}

.contact-quick-card::after {
  content: "";
  position: absolute;
  right: -28px;
  bottom: -42px;
  width: 90px;
  height: 90px;
  border: 1px solid rgba(8, 104, 189, 0.1);
  border-radius: 50%;
}

.contact-quick-card.quick-orange { border-top-color: #f7941d; }
.contact-quick-card.quick-blue { border-top-color: #0878d1; }
.contact-quick-card:hover { transform: translateY(-4px); box-shadow: 0 16px 30px rgba(6, 55, 105, 0.16); }

.contact-quick-card .quick-icon {
  position: relative;
  z-index: 1;
  flex-basis: 43px;
  width: 43px;
  height: 43px;
  box-shadow: 0 5px 12px rgba(7, 91, 166, 0.18);
  font-size: 9px;
}

.contact-quick-card .quick-icon svg {
  width: 21px;
  height: 21px;
}

.contact-quick-card > span:last-child { position: relative; z-index: 1; min-width: 0; }
.contact-quick-card b { margin-bottom: 3px; color: #123c6d; font-size: 12px; font-weight: 800; }
.contact-quick-card strong { margin-bottom: 3px; color: #204d7e; font-size: 13px; line-height: 1.22; }
.contact-quick-card small { color: #6c86a0; font-size: 11px; line-height: 1.28; }

/* Match the home page's wide content canvas instead of the old 1180px lock. */
@media (min-width: 901px) {
  .contact-page .contact-hero-inner,
  .contact-page .contact-main {
    width: min(1600px, calc(100% - 80px)) !important;
  }

  .contact-page .contact-main {
    max-width: 1600px !important;
  }

  .contact-page .contact-work-grid {
    grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr);
  }

  .contact-page .contact-form-card,
  .contact-page .contact-office-card,
  .contact-page .contact-why-card {
    border-radius: 14px;
  }
}

/* Final width lock for the contact-page content sections. */
@media (min-width: 901px) {
  .contact-page .contact-hero-inner,
  .contact-page .contact-main {
    width: min(1350px, calc(100% - 80px)) !important;
    max-width: 1350px !important;
  }
}

/* Premium contact-content finish. */
.contact-page .contact-main {
  position: relative;
  isolation: isolate;
}

.contact-page .contact-main::before,
.contact-page .contact-main::after {
  content: "";
  position: absolute;
  z-index: -1;
  pointer-events: none;
  border-radius: 50%;
  filter: blur(2px);
}

.contact-page .contact-main::before {
  top: 80px;
  left: -180px;
  width: 360px;
  height: 360px;
  background: radial-gradient(circle, rgba(8, 120, 209, .1), transparent 68%);
}

.contact-page .contact-main::after {
  top: 430px;
  right: -180px;
  width: 380px;
  height: 380px;
  background: radial-gradient(circle, rgba(247, 148, 29, .09), transparent 68%);
}

.contact-page .contact-quick-grid,
.contact-page .contact-work-grid,
.contact-page .contact-map-section,
.contact-page .cta-section { position: relative; z-index: 1; }

.contact-page .contact-form-card {
  border: 2px solid transparent;
  background:
    linear-gradient(#ffffff, #ffffff) padding-box,
    linear-gradient(135deg, rgba(8, 120, 209, .65), rgba(247, 148, 29, .7)) border-box;
  box-shadow: 0 18px 38px rgba(6, 55, 105, .11);
}

.contact-page .contact-form-card:hover {
  box-shadow: 0 22px 44px rgba(6, 55, 105, .15);
}

.contact-page .contact-office-card,
.contact-page .contact-why-card {
  border-radius: 16px;
  box-shadow: 0 14px 30px rgba(6, 55, 105, .1);
}

.contact-page .contact-field input,
.contact-page .contact-field select,
.contact-page .contact-field textarea {
  border-color: #cbddec;
  background: #fbfdff;
}

.contact-page .contact-field input:hover,
.contact-page .contact-field select:hover,
.contact-page .contact-field textarea:hover {
  border-color: #8eb9df;
}

.contact-page .contact-submit {
  min-width: 178px;
  box-shadow: 0 10px 20px rgba(247, 116, 22, .22);
}

/* Merge form, image and office details into one continuous contact panel. */
.contact-page .contact-work-grid {
  grid-template-columns: minmax(0, 1.06fr) minmax(0, .94fr);
  gap: 0 !important;
  margin-top: 52px !important;
  overflow: hidden;
  border: 1px solid #d7e5f1;
  border-radius: 22px;
  background: #ffffff;
  box-shadow: 0 18px 38px rgba(6, 55, 105, .11);
}

.contact-page .contact-form-card {
  min-width: 0;
  border: 0 !important;
  border-radius: 0 !important;
  background: #ffffff !important;
  box-shadow: none !important;
}

.contact-page .contact-side {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
  border-left: 1px solid #dbe8f3;
  background: linear-gradient(180deg, #fafdff 0%, #f1f8fd 100%);
}

.contact-page .contact-why-card,
.contact-page .contact-office-card {
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  background: transparent !important;
}

.contact-page .contact-why-card > img {
  height: 285px;
  border-radius: 0;
}

.contact-page .contact-office-card {
  border-top: 1px solid #dbe8f3 !important;
}

.contact-page .contact-next-step {
  position: relative;
  display: grid;
  grid-template-columns: 42px 1fr 34px;
  align-items: center;
  gap: 14px;
  min-height: 112px;
  margin-top: auto;
  padding: 22px 28px 26px;
  border-top: 1px solid #dbe8f3;
  overflow: hidden;
}

.contact-page .contact-next-step::after {
  content: "";
  position: absolute;
  right: -35px;
  bottom: -70px;
  width: 180px;
  height: 180px;
  border: 1px solid rgba(247, 148, 29, .28);
  border-radius: 50%;
  box-shadow: 0 0 0 22px rgba(247, 148, 29, .06), 0 0 0 44px rgba(247, 148, 29, .04);
}

.contact-page .next-step-number {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border-radius: 50%;
  color: #fff;
  background: linear-gradient(135deg, #f7941d, #f37021);
  box-shadow: 0 7px 16px rgba(247, 116, 22, .2);
  font-size: 12px;
  font-weight: 800;
}

.contact-page .contact-next-step b {
  display: block;
  margin-bottom: 4px;
  color: #0b315f;
  font-size: 14px;
}

.contact-page .contact-next-step p {
  max-width: 360px;
  margin: 0;
  color: #607b99;
  font-size: 11px;
  line-height: 1.45;
}

.contact-page .contact-next-step > a {
  position: relative;
  z-index: 1;
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border-radius: 50%;
  color: #fff;
  background: #0878d1;
  font-size: 18px;
  transition: transform .2s ease, background .2s ease;
}

.contact-page .contact-next-step > a:hover {
  transform: translateX(3px);
  background: #f37021;
}

/* Final unified-panel visual treatment. */
.contact-page .contact-work-grid {
  background: linear-gradient(110deg, #ffffff 0%, #f9fcff 50%, #eef8fd 100%);
  box-shadow: 0 22px 46px rgba(6, 55, 105, .13);
}

.contact-page .contact-form-card {
  position: relative;
  padding: 40px 36px 36px;
  background: linear-gradient(145deg, #ffffff 0%, #fbfdff 100%) !important;
}

.contact-page .contact-form-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 150px;
  height: 4px;
  border-radius: 0 0 4px 0;
  background: linear-gradient(90deg, #0878d1, #f7941d);
}

.contact-page .contact-side {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 96% 88%, rgba(247, 148, 29, .15), transparent 26%),
    radial-gradient(circle at 12% 76%, rgba(8, 120, 209, .1), transparent 30%),
    linear-gradient(180deg, #fafdff 0%, #eef8fd 100%);
}

.contact-page .contact-side::before {
  content: "";
  position: absolute;
  right: -90px;
  bottom: -115px;
  width: 280px;
  height: 280px;
  border: 1px solid rgba(8, 120, 209, .18);
  border-radius: 50%;
  box-shadow: 0 0 0 24px rgba(8, 120, 209, .05), 0 0 0 48px rgba(247, 148, 29, .045);
  pointer-events: none;
}

.contact-page .contact-side > * { position: relative; z-index: 1; }

.contact-page .contact-office-card {
  padding: 30px 32px 28px;
}

.contact-page .office-details-grid > div {
  position: relative;
  padding-left: 25px;
}

.contact-page .office-details-grid > div::before {
  content: "";
  position: absolute;
  top: 3px;
  left: 0;
  width: 9px;
  height: 9px;
  border: 2px solid #0878d1;
  border-radius: 50%;
  background: #ffffff;
}

.contact-page .office-details-grid > div:nth-child(2n)::before {
  border-color: #f7941d;
}

.contact-page .contact-next-step {
  background: rgba(255, 255, 255, .24);
}


/* Office details card polish. */
.contact-page .contact-office-card {
  position: relative;
  overflow: hidden;
  padding: 28px 30px 30px;
  border-top: 1px solid #dbe8f3 !important;
  background:
    radial-gradient(circle at 100% 100%, rgba(247, 148, 29, .1), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #f3faff 100%) !important;
}

.contact-page .contact-office-card::after {
  content: "";
  position: absolute;
  right: -45px;
  bottom: -75px;
  width: 220px;
  height: 180px;
  border: 1px solid rgba(247, 148, 29, .2);
  border-radius: 50%;
  box-shadow: 0 0 0 22px rgba(247, 148, 29, .045), 0 0 0 44px rgba(8, 120, 209, .035);
  pointer-events: none;
}

.contact-page .contact-office-card > * { position: relative; z-index: 1; }
.contact-page .contact-office-card h2 { margin-bottom: 22px; color: #0b315f; font-size: 30px; }

.contact-page .office-details-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  margin: 0;
  border-top: 1px solid #dce9f3;
  border-left: 0;
}

.contact-page .office-details-grid > div {
  display: grid;
  grid-template-columns: 38px 1fr;
  gap: 0 12px;
  min-height: 94px;
  align-content: center;
  padding: 17px 18px 17px 0;
  border: 0;
  border-bottom: 1px solid #dce9f3;
  border-left: 0;
}

.contact-page .office-details-grid > div:nth-child(odd) {
  padding-right: 22px;
  border-right: 1px solid #dce9f3;
}

.contact-page .office-details-grid > div:nth-child(even) { padding-left: 22px; }

.contact-page .office-details-grid > div::before {
  content: attr(data-icon);
  position: static;
  grid-row: 1 / span 2;
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border: 0;
  border-radius: 50%;
  color: #ffffff;
  background: linear-gradient(135deg, #0878d1, #0755a2);
  box-shadow: 0 5px 12px rgba(8, 104, 189, .18);
  font-size: 15px;
  font-weight: 700;
}

.contact-page .office-details-grid > div:nth-child(2n)::before {
  background: linear-gradient(135deg, #ff9b19, #f37021);
  box-shadow: 0 5px 12px rgba(247, 116, 22, .18);
}

.contact-page .office-details-grid > div b,
.contact-page .office-details-grid > div span,
.contact-page .office-details-grid > div a { grid-column: 2; }
.contact-page .office-details-grid > div b { color: #0b315f; font-size: 12px; }
.contact-page .office-details-grid > div span,
.contact-page .office-details-grid > div a { color: #5d7896; font-size: 11px; line-height: 1.45; }

/* Stronger page palette so the contact page does not feel flat white. */
.contact-page {
  background:
    radial-gradient(circle at 8% 32%, rgba(8, 120, 209, .13), transparent 26%),
    radial-gradient(circle at 94% 58%, rgba(247, 148, 29, .1), transparent 24%),
    linear-gradient(135deg, #e7f4fc 0%, #f5fbff 48%, #e0f0fa 100%) !important;
}

.contact-page .contact-main {
  padding-top: 4px;
}

.contact-page .contact-work-grid {
  border: 1px solid rgba(8, 120, 209, .22);
  background: linear-gradient(115deg, #e4f3fc 0%, #d9edf8 52%, #cce5f4 100%);
  box-shadow: 0 22px 48px rgba(6, 55, 105, .15);
}

.contact-page .contact-form-card {
  background: linear-gradient(145deg, rgba(247, 252, 255, .96), rgba(230, 244, 252, .96)) !important;
}

.contact-page .contact-side {
  background:
    radial-gradient(circle at 100% 88%, rgba(247, 148, 29, .16), transparent 28%),
    linear-gradient(180deg, rgba(220, 240, 250, .95), rgba(195, 224, 240, .95));
}

.contact-page .contact-office-card {
  background: linear-gradient(135deg, rgba(247, 252, 255, .92), rgba(226, 242, 251, .88)) !important;
}

.contact-page .contact-map-section {
  border-color: rgba(8, 120, 209, .22);
  background: linear-gradient(135deg, #e6f4fc 0%, #d5ebf7 100%);
  box-shadow: 0 18px 38px rgba(6, 55, 105, .1);
}

.contact-page .map-contact-list > * {
  border-color: rgba(8, 120, 209, .2);
  background: rgba(255, 255, 255, .58);
}

@media (max-width: 900px) {
  .contact-page .contact-work-grid {
    grid-template-columns: 1fr;
    margin-top: 28px !important;
    border-radius: 18px;
  }

  .contact-page .contact-side {
    border-top: 1px solid #dbe8f3;
    border-left: 0;
  }

  .contact-page .contact-why-card > img { border-radius: 0; }
  .contact-page .nav-list { gap: 12px; }.contact-quick-grid { grid-template-columns: repeat(2, 1fr); }.contact-work-grid, .contact-map-section { grid-template-columns: 1fr; }.contact-cta-strip { margin-left: calc((900px - 100vw) / 2); margin-right: calc((900px - 100vw) / 2); padding-left: 28px; padding-right: 28px; }.contact-page .footer-container { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 620px) {
  .contact-page .header-container { height: 66px; }.contact-page .site-header .brand-symbol { width: 130px; height: 46px; flex-basis: 130px; }.contact-page .nav-list { display: none; }.contact-page .header-btn-touch { display: none; }.contact-page .contact-hero { min-height: 365px; }.contact-page .contact-hero-image { inset: 0; width: 100%; opacity: .3; }.contact-page .contact-hero-inner { width: calc(100% - 28px); padding-top: 24px; }.contact-page .contact-hero h1 { font-size: 43px; }.contact-page .contact-hero h2 { font-size: 18px; }.contact-page .contact-main { width: calc(100% - 28px); }.contact-quick-grid { grid-template-columns: 1fr; }.contact-work-grid { gap: 13px; }.contact-page .contact-form-card { padding: 21px 17px; }.contact-why-panel { right: 12px; width: 180px; }.office-details-grid { grid-template-columns: 1fr; }.contact-map-visual { min-height: 230px; }.contact-cta-strip { display: block; margin: 30px -14px -2px; padding: 28px 18px; }.contact-cta-strip a { margin-top: 16px; }.contact-page .footer-container { grid-template-columns: 1fr; gap: 28px; }.contact-page .footer-body { padding: 36px 0 28px; }
}

/* Map section polish: stronger hierarchy, aligned contact rows, and a lighter visual card. */
.contact-page .contact-map-section {
  position: relative;
  overflow: hidden;
  padding: 34px;
  border: 1px solid rgba(8, 120, 209, .22);
  border-radius: 20px;
  background:
    radial-gradient(circle at 4% 100%, rgba(8, 120, 209, .13), transparent 32%),
    radial-gradient(circle at 95% 0%, rgba(247, 148, 29, .1), transparent 30%),
    linear-gradient(135deg, #e8f5fd 0%, #d6ecf7 100%);
  box-shadow: 0 18px 38px rgba(6, 55, 105, .1);
}

.contact-page .contact-map-section::after {
  content: "";
  position: absolute;
  right: -85px;
  bottom: -105px;
  width: 260px;
  height: 260px;
  border: 1px solid rgba(247, 148, 29, .22);
  border-radius: 50%;
  box-shadow: 0 0 0 24px rgba(247, 148, 29, .05), 0 0 0 48px rgba(8, 120, 209, .04);
  pointer-events: none;
}

.contact-page .contact-map-copy {
  position: relative;
  z-index: 1;
}

.contact-page .contact-map-copy h2 {
  margin-bottom: 10px;
  font-size: clamp(32px, 3.2vw, 44px);
  letter-spacing: -.02em;
}

.contact-page .contact-map-copy h2 span { color: #f37021; }

.contact-page .contact-map-copy > p {
  max-width: 440px;
  font-size: 13px;
  line-height: 1.6;
  color: #557394;
}

.contact-page .map-contact-list {
  position: relative;
  z-index: 1;
  gap: 10px;
}

.contact-page .map-contact-list > * {
  position: relative;
  display: grid;
  grid-template-columns: 40px 90px 1fr;
  align-items: center;
  min-height: 56px;
  padding: 10px 16px;
  border: 1px solid rgba(8, 120, 209, .18);
  border-radius: 11px;
  background: rgba(255, 255, 255, .72);
  box-shadow: 0 5px 14px rgba(6, 55, 105, .05);
  transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
}

.contact-page .map-contact-list > *::before {
  content: attr(data-icon);
  display: grid;
  width: 30px;
  height: 30px;
  place-items: center;
  border-radius: 50%;
  color: #fff;
  background: linear-gradient(135deg, #0878d1, #0755a2);
  font-size: 13px;
  font-weight: 800;
}

.contact-page .map-contact-list > *:nth-child(2)::before,
.contact-page .map-contact-list > *:nth-child(3)::before {
  background: linear-gradient(135deg, #ff9b19, #f37021);
}

.contact-page .map-contact-list b {
  grid-column: 2;
  font-size: 11px;
  color: #0b315f;
}

.contact-page .map-contact-list span {
  grid-column: 3;
  font-size: 11px;
  color: #5d7896;
}

.contact-page .map-contact-list > *:hover {
  transform: translateX(3px);
  border-color: #8bbce2;
  box-shadow: 0 8px 18px rgba(6, 55, 105, .09);
}

@media (max-width: 900px) {
  .contact-page .contact-map-section {
    padding: 24px 18px;
    border-radius: 16px;
  }

  .contact-page .map-contact-list > * {
    grid-template-columns: 38px 85px 1fr;
  }
}

@media (max-width: 620px) {
  .contact-page .map-contact-list > * {
    grid-template-columns: 34px 1fr;
    gap: 4px 10px;
  }

  .contact-page .map-contact-list b,
  .contact-page .map-contact-list span {
    grid-column: 2;
  }
}
